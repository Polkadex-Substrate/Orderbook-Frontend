# Environment Variables for Rust GraphQL Backend Migration

# ============================================
# GraphQL Backend Configuration
# ============================================

# New Rust GraphQL Backend (LocalStack - when available)
# Uncomment and update these when LocalStack is running
# GRAPHQL_URL=http://localhost:8080/graphql
# GRAPHQL_WS_URL=ws://localhost:8080/ws

# Feature flag to toggle between backends
# Set to 'true' to use new Rust backend, 'false' to use AppSync
USE_NEW_BACKEND=false

# ============================================
# Existing AppSync Configuration (Keep for rollback)
# ============================================
# These should already be set in your current .env
# API_REGION=us-east-1
# GRAPHQL_URL=https://xxx.appsync-api.us-east-1.amazonaws.com/graphql
# READ_ONLY_TOKEN=your-read-only-token

# ============================================
# Notes
# ============================================
# 1. Keep USE_NEW_BACKEND=false until LocalStack is ready and tested
# 2. Do NOT remove AppSync configuration until migration is complete
# 3. Update GRAPHQL_URL and GRAPHQL_WS_URL when LocalStack is deployed
