# ============================================================================
# OFE (apps/hestia) environment template
#
# Copy to `.env` and fill in the values. `.env` itself is untracked - this
# file exists because required keys have silently vanished from `.env` during
# rewrites THREE times (ENABLE_FAUCET, FAUCET_URL/API_KEY, the react-query
# pin's sibling vars), and each loss surfaced as a confusing runtime bug
# (dead nav links, mystery 404s, missing modals). When you add a key to
# `.env`, add it here too, with a comment saying what breaks without it.
#
# NEXT_PUBLIC_* values are baked into the browser bundle AT BUILD TIME -
# changing them requires a rebuild, not just a server restart. They are also
# visible to anyone using the site: never put real secrets in them.
# ============================================================================

# ── WalletConnect ────────────────────────────────────────────────────
# REQUIRED AT BOOT: src/config/wagmi.ts throws without it.
# Get a project id at https://cloud.reown.com (free tier is fine).
# A dummy value boots the app, but the EVM wallet modal on /bridge silently
# fails (relay rejects it → anonymous "{}" console errors, dead QR connect).
# Public identifier, not a credential - it ships in the bundle either way. Filled
# so a fresh copy boots; swap it for your own Reown project before deploying to a
# new host, since WalletConnect checks the origin against that project's allowlist.
NEXT_PUBLIC_PROJECT_ID=b87e50ee46c399e8a602ebab081e9125

# ── Chart datafeed (REQUIRED) ────────────────────────────────────────
# The chart reads candles from the REST datafeed gateway over UDF. Both of
# these are required: without SERVER_BASE_URL the chart has no endpoint and
# renders its error state, and the gateway rejects calls with no secret.
#
# GATEWAY_SECRET is public by nature - NEXT_PUBLIC_* ships in the browser
# bundle. Do not reuse it for anything that matters.
#
# NEXT_PUBLIC_NATIVE_CHART used to switch between two chart implementations
# reading from two different backends. It is removed: the server had it set
# and a developer's env omitted it, so the two environments quietly rendered
# different components against different data sources.
NEXT_PUBLIC_SERVER_BASE_URL=https://datafeed.polkadex.ee
NEXT_PUBLIC_GATEWAY_SECRET=

# ── Backend connection ───────────────────────────────────────────────
# Chain websocket (wss://...) and GraphQL endpoint. Note: the self-hosted
# Rust GraphQL server has no AWSDateTime scalar - the frontend queries are
# written for it (see packages/core/src/graphql/queries.ts). If you point
# GRAPHQL_URL back at real AppSync, those declarations must revert.
POLKADEX_CHAIN=wss://polkadex-testnet.polkadex.ee
GRAPHQL_URL=https://orderbook-api-test.polkadex.ee
API_REGION=
# false = existing AppSync-compatible backend; true = new Rust Apollo path
# (packages/core/src/config/graphql.ts). Keep false unless you know why.
USE_NEW_BACKEND=false
GRAPHQL_WS_URL=wss://orderbook-api-test.polkadex.ee/ws

# ── App defaults ─────────────────────────────────────────────────────
# LANDING_PAGE must be a market that EXISTS on this deployment (base+quote
# tickers concatenated, e.g. PDEXUSDT). "/" and "/trading" redirect to it -
# a nonexistent pair lands users on an unknown-market page.
LANDING_PAGE=WETHUSDT
MAIN_URL=/trading

# ── Feature flags ────────────────────────────────────────────────────
IS_BRIDGE_ENABLED=true
ENABLE_LMP=false
# NB: spelling is MAINTENACE_MODE (sic) - matches the code, don't "fix" it here.
MAINTENACE_MODE=false

# ── Indexer / explorer ───────────────────────────────────────────────
SUBQUERY_URL=https://sq-indexer.polkadex.ee
NEXT_PUBLIC_SUBQUERY_URL=https://sq-indexer.polkadex.ee
SUBSCAN_API=https://polkadex.api.subscan.io

# ── Google Drive backup (optional) ───────────────────────────────────
# Unset = the GDrive wallet-backup option is unavailable; everything else
# works. Misconfigured (rather than empty) values log
# "[GDrive OAuth] config error:" in the console.
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=

# ── Hyperbridge Sepolia ↔ Polkadex-testnet route ─────────────────────
# All five REQUIRED for /bridge to function.
NEXT_PUBLIC_BRIDGE_DESTINATION_RPC_URL=wss://polkadex-testnet.polkadex.ee
NEXT_PUBLIC_BRIDGE_ISMP_HOST=0x2EdB74C269948b60ec1000040E104cef0eABaae8
NEXT_PUBLIC_BRIDGE_INDEXER_URL=https://hyperbridge-paseo-rpc.blockops.network
NEXT_PUBLIC_POLKADEX_STATE_MACHINE=SUBSTRATE-PDEX

# Optional maintenance gate for /bridge:
# NEXT_PUBLIC_IS_HYPERBRIDGE_MAINTENANCE=false
# NEXT_PUBLIC_HYPERBRIDGE_MAINTENANCE_MESSAGE=

# ── Public site URL ──────────────────────────────────────────────────
# Absolute origin this deployment is served from. Used as metadataBase so
# og:image / twitter:image resolve to absolute URLs - social crawlers do not
# follow relative paths, and without this every link preview loses its image.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://testnet.polkadex.ee

# ── Testnet gating ───────────────────────────────────────────────────
# Drives BOTH the faucet (route + nav link, via src/proxy.ts) and the
# testnet-notice modal (src/components/ui/testnetModal.tsx).
# Unset/false = faucet nav disabled, /faucet redirects, no modal.
NEXT_PUBLIC_ENABLE_FAUCET=true

# REQUIRED when faucet is enabled - with FAUCET_URL empty, requests go to
# the Next app itself ("/api/register") and 404. The form now fails fast
# with a clear message, but it still can't work without these.
# URL = base URL of the faucet backend service; API_KEY = its X-API-Key.
NEXT_PUBLIC_FAUCET_URL=https://faucet-api-test.polkadex.ee
NEXT_PUBLIC_FAUCET_API_KEY=

# ── Sentry ───────────────────────────────────────────────────────────
# The DSN is PUBLIC by design - it ships in the browser bundle, which is how
# client-side error reporting works. It is not a credential.
SENTRY_DSN=

# Which deployment this is: testnet / staging / production.
# Unset, the SDK reports the literal string "production" for EVERY build,
# local ones included, so Sentry's environment filter cannot separate them.
SENTRY_ENVIRONMENT=local

# Sampling. Optional; code defaults are 0.1 traces and 0 replay sessions.
# Errors are ALWAYS captured at 100% - only traces and replays are sampled, and
# both meter against separate quotas. Exhausting a quota makes Sentry drop
# events INCLUDING errors, so over-sampling traces costs you the errors you
# installed it for.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_REPLAY_SESSION_SAMPLE_RATE=0

# ── Source-map upload ────────────────────────────────────────────────
# ALL THREE are required together. With any one missing the upload is a silent
# no-op and every stack trace in Sentry arrives minified, e.g.
#   at 23140/sy</< (chunks/00f76785.ad4e0cb6c80b7805.js:9:63466)
# ...with 45 frames hidden. build-release.sh warns when they are absent.
#
# ORG and PROJECT are not secrets - they appear in every Sentry URL. PROJECT is
# the project SLUG and must match Sentry exactly; renaming the project there
# without updating this silently breaks the upload again. (The DSN keys on the
# project ID, not the slug, so a rename does not affect reporting itself.)
SENTRY_ORG=polkadex-2v
SENTRY_PROJECT=polkadex-orderbook-fe-test

# The token IS a secret. build-release.sh passes it to Docker as a BuildKit
# secret, never a build arg, so it does not land in an image layer or in
# `docker history`. Mint at Sentry > Settings > Auth Tokens with scope
# project:releases. Leave EMPTY for local builds: with a token present, a local
# `yarn build` registers a release in the production Sentry project, which is
# where those stray 0.1.0-<sha>-dirty releases came from.
SENTRY_AUTH_TOKEN=

# Release tag. Leave unset - the Dockerfile defaults it to NEXT_BUILD_ID, which
# build-release.sh sets to the build stamp. Without a release Sentry cannot tell
# a regression from a pre-existing issue, and cannot reliably match source maps.
# SENTRY_RELEASE=

# ── Defaults added so a copied template boots unedited ────────────────
# Rule applied here: PUBLIC identifiers and contract addresses are filled in;
# anything that acts as a CREDENTIAL is left blank even when it already ships in
# the browser bundle. This file is committed to git, so a credential here would
# live in history and in every fork - a wider exposure than the bundle.

# Flags. Empty is meaningful for these: DISABLED_FEATURES defaults to
# ["payWithAnotherFee"] when ABSENT, so leave it present-and-empty to disable
# nothing. Same shape for the others.
BLOCKED_ASSETS=
DISABLED_FEATURES=
UNDER_MAINTENACE=

# App defaults.
DEFAULT_TRANSFER_TOKEN=USDT
NEXT_PUBLIC_ANALYZE=false
NEXT_PUBLIC_APP_URL=https://testnet.polkadex.ee
# !! THIS HOST IS DEAD. app-staging.hyperbridge.network returns NXDOMAIN. !!
# It is the iframe src in bridge/HyperbridgeEmbed.tsx, so that embed currently
# loads nothing. app.hyperbridge.network resolves but looks like MAINNET, and no
# testnet UI could be verified - do not just swap it in. Confirm the correct
# testnet URL with the Hyperbridge team before trusting this value.
NEXT_PUBLIC_HYPERBRIDGE_URL=https://app-staging.hyperbridge.network/bridge
NEXT_PUBLIC_YBUG_ID=4txsdnfmrg67j2qm1sc5
SHOW_SHUTDOWN_POPUP=false
SIGNUP_DISABLED=false

# Sepolia bridge contracts. Public on-chain addresses, not secrets.
NEXT_PUBLIC_BRIDGE_AAVE_ADDRESS=0x8D7392d6e955a87B41383037826157011700B2c8
NEXT_PUBLIC_BRIDGE_AAVE_HFT_ADDRESS=0xb41c54efBEB52679B81f120321f71b4E226e8BfA
NEXT_PUBLIC_BRIDGE_LINK_ADDRESS=0xEfa898bCb94Cc119F4687F47dc77E68f5F097197
NEXT_PUBLIC_BRIDGE_LINK_HFT_ADDRESS=0xc5b50D42df0fB4CEC7c539417C310D586Fb9d254
NEXT_PUBLIC_BRIDGE_UNI_ADDRESS=0x491497cf6ec0D498A0586Af9679F0F5dA94e4e24
NEXT_PUBLIC_BRIDGE_UNI_HFT_ADDRESS=0x1628b0746d94f8392c3e78CfBea0a9EF288ABc4C
NEXT_PUBLIC_BRIDGE_USDC_ADDRESS=0xb177b85d589B806E9e82C02e5b92180a4B4d90bb
NEXT_PUBLIC_BRIDGE_USDC_HFT_ADDRESS=0x640D825B10CE1527f09474D88322c25Fef74cb66
NEXT_PUBLIC_BRIDGE_USDT_ADDRESS=0x086d2f4CCD29D6CbD921EF0aa09EC20F67f7d69D
NEXT_PUBLIC_BRIDGE_USDT_HFT_ADDRESS=0x2f89c6D23514d50DE6B9759f283b0797380B13cc
NEXT_PUBLIC_BRIDGE_WBTC_ADDRESS=0xf32CCA1B10C65553690F9F72Afe8df13CC33A406
NEXT_PUBLIC_BRIDGE_WBTC_HFT_ADDRESS=0x77037D488Bd4b20cB5BD86D4Bf7741887cd2Cf31
NEXT_PUBLIC_BRIDGE_WETH_ADDRESS=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
NEXT_PUBLIC_BRIDGE_WETH_HFT_ADDRESS=0xdeFB8141353e8f190a5dA3813290A6d71cC89be5
NEXT_PUBLIC_BRIDGE_WSTETH_ADDRESS=0xcF47f5C69aE7bEee74C12d37fe5842dA64e4f9aa
NEXT_PUBLIC_BRIDGE_WSTETH_HFT_ADDRESS=0x84bA5D441C10614B38e8B2032Ffe3B026a7ADB4d

# Keyless public Sepolia RPC. The deployed env uses a drpc endpoint with an API
# key embedded in the URL - deliberately NOT copied here. Restrict that key by
# domain in the drpc dashboard; it is the only control that works client-side.
NEXT_PUBLIC_BRIDGE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Google Analytics measurement id. The Dockerfile ARG is GOOGLE_ANALYTICS and
# next.config.js maps it to NEXT_PUBLIC_GA_MEASUREMENT_ID. Blank = no analytics.
GOOGLE_ANALYTICS=

# Empty falls back to the literal string "READ_ONLY", which is what the
# deployment has always sent. Present-but-empty so build-release.sh sees it.
READ_ONLY_TOKEN=


# Bridge maintenance banner. QUOTE any value containing an apostrophe: this file
# is sourced by build-release.sh, so the shell parses every line and "We'll" opens
# a quote that never closes, failing the build with a bare "unexpected EOF".
NEXT_PUBLIC_IS_HYPERBRIDGE_MAINTENANCE=false
NEXT_PUBLIC_HYPERBRIDGE_MAINTENANCE_MESSAGE="Token bridging is undergoing maintenance and will be back shortly."

# ── Mainnet bridge fee model (flag OFF here: testnet relayers are subsidised) ──
# true on MAINNET only. When on: the relayer fee (in the bridged asset's units)
# is added to every funding-balance check and attached to the extrinsic, and the
# form blocks below the PDEX gas floor instead of failing at signing.
NEXT_PUBLIC_BRIDGE_MAINNET_FEES=false
NEXT_PUBLIC_BRIDGE_RELAYER_FEE=0
NEXT_PUBLIC_BRIDGE_MIN_PDEX=0.5
