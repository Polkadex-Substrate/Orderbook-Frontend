# Copy to scripts/deploy.conf and edit. Sourced by scripts/deploy.sh, so
# command-line flags still override anything set here.
# deploy.conf is gitignored: it names one specific host, not the project.

DOMAIN="testnet.polkadex.ee"
ENV_FILE="apps/hestia/.env"
IMAGE_REPO="orderbook-fe"

# 1 = on, 0 = off
CLOUDFLARE=1     # Cloudflare origin cert + real-IP + CF-only firewall
HARDEN=1         # sysctl, firewall, fail2ban, auto-updates
DO_PULL=1        # git pull before building

# Anything extra to pass straight to install.sh, e.g.:
# EXTRA_INSTALL_ARGS="--cf-origin-pull --ssh-port 2222"
EXTRA_INSTALL_ARGS=""
