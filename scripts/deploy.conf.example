# Copy to scripts/deploy.conf and edit. Sourced by scripts/deploy.sh, so
# command-line flags still override anything set here.
# deploy.conf is gitignored: it names one specific host, not the project.

DOMAIN="testnet.polkadex.ee"
ENV_FILE="apps/hestia/.env"
IMAGE_REPO="orderbook-fe"

# 1 = on, 0 = off
CLOUDFLARE=1     # Cloudflare origin cert + real-IP + CF-only firewall
DO_PULL=1        # git pull before building

# Host hardening is NOT part of a routine deploy: it resets the firewall and
# reinstalls fail2ban, which is right once and wrong on every push.
#   auto (default) = skip if /etc/orderbook-fe/.hardened exists, else offer it
#                    once interactively
#   1              = always apply
#   0              = never apply, never ask (set this in CI)
HARDEN=auto

# Anything extra to pass straight to install.sh, e.g.:
# EXTRA_INSTALL_ARGS="--cf-origin-pull --ssh-port 2222"
EXTRA_INSTALL_ARGS=""

# Old installs are moved to /opt/orderbook-fe.bak.<timestamp>. Each is ~140 MB,
# so they are pruned to this many. 0 = keep none (no rollback target).
KEEP_BACKUPS=3

# 0 = keep the runtime env already on the server (hand-edits survive; changes
#     to the source env file are ignored, with a warning).
# 1 = overwrite it from ENV_FILE on every deploy.
REPLACE_ENV=0
