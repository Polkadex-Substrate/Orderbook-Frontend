{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "lib/**"
      ],
      "env": [
        "POLKADEX_CHAIN",
        "GOOGLE_ANALYTICS",
        "ANALYZE",
        "API_REGION",
        "GRAPHQL_URL",
        "GRAPHQL_WS_URL",
        "USE_NEW_BACKEND",
        "SUBQUERY_URL",
        "READ_ONLY_TOKEN",
        "IDENTITY_POOL_ID",
        "USER_POOL_ID",
        "USER_WEB_CLIENT_ID",
        "LANDING_PAGE",
        "SIGNUP_DISABLED",
        "PIN_POINT_CLIENT_ID",
        "MAINTENACE_MODE",
        "SHOW_SHUTDOWN_POPUP",
        "UNDER_MAINTENACE",
        "ENABLE_LMP",
        "IS_BRIDGE_ENABLED",
        "MAIN_URL",
        "BLOCKED_ASSETS",
        "DEFAULT_TRANSFER_TOKEN",
        "SUBSCAN_API",
        "SENTRY_DSN",
        "SENTRY_AUTH",
        "DISABLED_FEATURES",
        "GOOGLE_API_KEY",
        "GOOGLE_CLIENT_ID",
        "DEFAULT_THEA_SOURCE_CHAIN",
        "DEFAULT_THEA_DESTINATION_CHAIN",
        "DISABLED_THEA_CHAINS",
        "NEXT_PUBLIC_HYPERBRIDGE_URL",
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        "NEXT_PUBLIC_ANALYZE",
        "NEXT_PUBLIC_SERVER_BASE_URL",
        "NEXT_PUBLIC_GATEWAY_SECRET",
        "NEXT_PUBLIC_PROJECT_ID",
        "NEXT_PUBLIC_NATIVE_CHART",
        "NEXT_PUBLIC_SUBQUERY_URL",
        "NEXT_PUBLIC_ENABLE_FAUCET",
        "NEXT_PUBLIC_FAUCET_URL",
        "NEXT_PUBLIC_FAUCET_API_KEY",
        "NEXT_PUBLIC_BRIDGE_DESTINATION_RPC_URL",
        "NEXT_PUBLIC_BRIDGE_SEPOLIA_RPC_URL",
        "NEXT_PUBLIC_BRIDGE_ISMP_HOST",
        "NEXT_PUBLIC_BRIDGE_INDEXER_URL",
        "NEXT_PUBLIC_POLKADEX_STATE_MACHINE"
      ]
    },
    "lint": {},
    "dev": {
      "dependsOn": [
        "generate"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "POLKADEX_CHAIN",
        "GOOGLE_ANALYTICS",
        "ANALYZE",
        "API_REGION",
        "GRAPHQL_URL",
        "IDENTITY_POOL_ID",
        "USER_POOL_ID",
        "USER_WEB_CLIENT_ID",
        "LANDING_PAGE",
        "SIGNUP_DISABLED",
        "PIN_POINT_CLIENT_ID",
        "MAINTENACE_MODE",
        "SHOW_SHUTDOWN_POPUP",
        "UNDER_MAINTENACE",
        "MAIN_URL",
        "BLOCKED_ASSETS",
        "DISABLED_FEATURES",
        "GOOGLE_API_KEY",
        "GOOGLE_CLIENT_ID"
      ]
    },
    "generate": {
      "cache": false
    }
  }
}
