{
  "name": "orderbook",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "release": "scripts/build-release.sh",
    "deploy": "scripts/deploy.sh"
  },
  "devDependencies": {
    "@orderbook/eslint-config": "*",
    "eslint": "^8.48.0",
    "prettier": "^3.0.3",
    "tsconfig": "*",
